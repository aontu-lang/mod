{
  "name": "@aontu/mod",
  "version": "0.2.0",
  "description": "The client half of the aontu package system's proof contract: a transparency-log verifier ported from golang.org/x/mod/sumdb/tlog and held to it by golden vectors, with C2SP tlog-tiles addressing and the key provider's proof beside it.",
  "license": "MIT AND BSD-3-Clause",
  "author": "Richard Rodger (https://richardrodger.com)",
  "homepage": "https://github.com/aontu-lang/mod#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aontu-lang/mod.git"
  },
  "bugs": {
    "url": "https://github.com/aontu-lang/mod/issues"
  },
  "keywords": [
    "transparency-log",
    "tlog",
    "sumdb",
    "merkle",
    "aontu"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.map",
    "src/**/*.ts",
    "vectors",
    "PROOF-CONTRACT.md",
    "LICENSE",
    "LICENSES",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM_GO_MOD.md"
  ],
  "scripts": {
    "build": "tsc --build src test",
    "prepare": "npm run build",
    "pretest": "npm run build",
    "test": "node --enable-source-maps --test \"dist-test/**/*.test.js\"",
    "pretest-cov": "npm run build",
    "test-cov": "node --enable-source-maps --experimental-test-coverage --test-coverage-exclude=\"dist-test/**\" --test-coverage-exclude=\"test/**\" --test \"dist-test/**/*.test.js\"",
    "pretest-cov-check": "npm run build",
    "test-cov-check": "node --enable-source-maps --experimental-test-coverage --test-coverage-exclude=\"dist-test/**\" --test-coverage-exclude=\"test/**\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test \"dist-test/**/*.test.js\"",
    "vectors": "cd goref && go run . > ../vectors/tlog.json",
    "clean": "rm -rf dist dist-test node_modules"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}
