From 61a37565cf14e86797f49e8605d0a7d8b1a97007 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 16 Sep 2026 11:49:58 +0000
Subject: [PATCH] ci: release @aontu/mod over OIDC trusted publishing, then tag

One file, because npm registers the trusted publisher against a
workflow filename and allows exactly one. Two jobs with different
privileges: publish holds id-token: write and contents: read, tag holds
contents: write and runs git only. Dispatch from main publishes what is
missing and tags; a v* tag pushed by hand publishes only. Nothing
publishes over a token.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01W4X2MprZjtGPiBVth8jTrW
---
 .github/workflows/publish.yml | 178 ++++++++++++++++++++++++++++++++++
 1 file changed, 178 insertions(+)
 create mode 100644 .github/workflows/publish.yml

diff --git a/.github/workflows/publish.yml b/.github/workflows/publish.yml
new file mode 100644
index 0000000..66a5b22
--- /dev/null
+++ b/.github/workflows/publish.yml
@@ -0,0 +1,178 @@
+# Releases @aontu/mod to npm over OIDC trusted publishing, then tags.
+#
+# ONE FILE, BECAUSE NPM ALLOWS EXACTLY ONE: the trusted publisher on
+# npmjs.com is registered against this workflow's filename in
+# aontu-lang/mod, and only this file can publish. Nothing here commits:
+# it reads the version on the branch and releases exactly that, so the
+# bump stays a reviewable diff and the release stays a button.
+#
+# TWO JOBS, BECAUSE THEY NEED DIFFERENT PRIVILEGES: publish runs npm
+# install and the tests with id-token: write and contents: read; tag
+# runs git and nothing else with contents: write, so no dependency
+# lifecycle script ever holds a repository-write credential.
+#
+# Two ways in: workflow_dispatch from main (publishes what is missing,
+# then tags), or a v* tag pushed by hand (publishes only).
+
+name: publish
+
+on:
+  push:
+    tags: ['v*']
+  workflow_dispatch:
+    inputs:
+      expect_sha:
+        description: 'Optional: refuse unless main is still at this commit'
+        type: string
+        default: ''
+
+jobs:
+  publish:
+    name: npm publish
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    permissions:
+      id-token: write
+      contents: read
+    outputs:
+      version: ${{ steps.version.outputs.version }}
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24.x
+          registry-url: 'https://registry.npmjs.org'
+
+      - name: Resolve the version being released
+        id: version
+        run: |
+          set -euo pipefail
+          V="$(node -p "require('./package.json').version")"
+          test -n "$V" || { echo "::error::could not read package.json version"; exit 1; }
+          echo "version=$V" >> "$GITHUB_OUTPUT"
+          echo "releasing $V as v$V"
+
+      - name: Dispatches must come from main
+        if: ${{ github.event_name == 'workflow_dispatch' }}
+        run: |
+          set -euo pipefail
+          if [ "$GITHUB_REF_NAME" != "main" ]; then
+            echo "::error::dispatch ref is $GITHUB_REF_NAME; releases come from main"
+            exit 1
+          fi
+
+      - name: main must still be the commit intended for release
+        if: ${{ github.event_name == 'workflow_dispatch' && inputs.expect_sha != '' }}
+        env:
+          EXPECT_SHA: ${{ inputs.expect_sha }}
+        run: |
+          set -euo pipefail
+          if [ "$GITHUB_SHA" != "$EXPECT_SHA" ]; then
+            echo "::error::main has moved: expected $EXPECT_SHA, got $GITHUB_SHA"
+            exit 1
+          fi
+
+      - name: A pushed tag must match the package version
+        if: ${{ github.event_name == 'push' }}
+        env:
+          V: ${{ steps.version.outputs.version }}
+        run: |
+          set -euo pipefail
+          if [ "$GITHUB_REF_NAME" != "v$V" ]; then
+            echo "::error::tag $GITHUB_REF_NAME does not match package.json (v$V)"
+            exit 1
+          fi
+
+      - name: Refuse a tag that points at a different commit
+        if: ${{ github.event_name == 'workflow_dispatch' }}
+        env:
+          V: ${{ steps.version.outputs.version }}
+        run: |
+          set -euo pipefail
+          AT="$(git rev-parse -q --verify "refs/tags/v$V^{commit}" 2>/dev/null || true)"
+          if [ -n "$AT" ] && [ "$AT" != "$(git rev-parse HEAD)" ]; then
+            echo "::error::tag v$V already exists on $AT, not this commit; bump package.json"
+            exit 1
+          fi
+
+      - run: npm ci
+      - run: npm run build
+      - run: npm test
+      - run: npm run test-cov-check
+
+      - name: Use a trusted-publishing capable npm
+        run: npm install -g npm@latest
+
+      - name: Is this version already on npm?
+        id: registry
+        env:
+          V: ${{ steps.version.outputs.version }}
+        run: |
+          set -euo pipefail
+          if npm view "@aontu/mod@$V" version >/dev/null 2>&1; then
+            echo "published=true" >> "$GITHUB_OUTPUT"
+            echo "$V is already on npm; skipping publish"
+          else
+            echo "published=false" >> "$GITHUB_OUTPUT"
+          fi
+
+      - name: A published version must come from this commit
+        if: ${{ steps.registry.outputs.published == 'true' }}
+        env:
+          V: ${{ steps.version.outputs.version }}
+        run: |
+          set -euo pipefail
+          GH="$(npm view "@aontu/mod@$V" gitHead 2>/dev/null || true)"
+          if [ -z "$GH" ]; then
+            echo "::error::npm records no gitHead for $V; it cannot be shown to be this commit"
+            exit 1
+          elif [ "$GH" != "$GITHUB_SHA" ]; then
+            echo "::error::npm has $V built from $GH, but this run is $GITHUB_SHA"
+            exit 1
+          fi
+
+      - name: Publish to npm
+        if: ${{ steps.registry.outputs.published == 'false' }}
+        env:
+          V: ${{ steps.version.outputs.version }}
+        run: |
+          set -euo pipefail
+          case "$V" in
+            *-*) DIST=next ;;
+            *)   DIST=latest ;;
+          esac
+          npm publish --access public --tag "$DIST"
+
+  tag:
+    name: tag
+    needs: publish
+    if: ${{ github.event_name == 'workflow_dispatch' }}
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      contents: write
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+      - name: Tag the release
+        env:
+          V: ${{ needs.publish.outputs.version }}
+        run: |
+          set -euo pipefail
+          TAG="v$V"
+          HEAD_SHA="$(git rev-parse HEAD)"
+          AT="$(git rev-parse -q --verify "refs/tags/$TAG^{commit}" 2>/dev/null || true)"
+          if [ -n "$AT" ]; then
+            if [ "$AT" != "$HEAD_SHA" ]; then
+              echo "::error::$TAG exists on $AT, not this commit ($HEAD_SHA)"
+              exit 1
+            fi
+            echo "$TAG already points here" >> "$GITHUB_STEP_SUMMARY"
+            exit 0
+          fi
+          git tag "$TAG"
+          git push origin "refs/tags/$TAG"
+          echo "pushed $TAG" >> "$GITHUB_STEP_SUMMARY"
-- 
