From 91f7b06808c067c8a73338fc4838d3c511944892 Mon Sep 17 00:00:00 2001
From: Richard Rodger <richard@ricebridge.com>
Date: Wed, 25 Nov 2026 18:56:07 +0000
Subject: [PATCH] CI runs Vale over the gated pages, pinned to 3.14.0

A job of its own in build.yml: install the pinned Vale, then npm run
vale, which syncs the pinned Google package, runs Vale at error level
and checks the counts .vale.ini records.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01U3n7wTuupT8S9CjEkAbrpe
---
 .github/workflows/build.yml | 25 +++++++++++++++++++++++++
 1 file changed, 25 insertions(+)

diff --git a/.github/workflows/build.yml b/.github/workflows/build.yml
index 46c7474..faebeb0 100644
--- a/.github/workflows/build.yml
+++ b/.github/workflows/build.yml
@@ -68,3 +68,28 @@ jobs:
       # that depends on which reporter is in use is not a gate.
       - name: 100% lines, branches and functions
         run: npm run test-cov-check
+
+  # The prose gate's Vale half. The comment and prose gates run inside
+  # npm test; Vale needs its own binary, pinned because a Vale release
+  # can change what a rule reports, and the Google package is pinned by
+  # URL in .vale.ini for the same reason.
+  vale:
+    name: Vale
+    timeout-minutes: 5
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 24.x
+      - name: Install Vale
+        env:
+          VALE_VERSION: '3.14.0'
+        run: |
+          set -euo pipefail
+          curl -sSfL -o vale.tar.gz \
+            "https://github.com/errata-ai/vale/releases/download/v${VALE_VERSION}/vale_${VALE_VERSION}_Linux_64-bit.tar.gz"
+          tar xzf vale.tar.gz vale
+          sudo mv vale /usr/local/bin/
+          vale --version
+      - run: npm run vale
-- 
